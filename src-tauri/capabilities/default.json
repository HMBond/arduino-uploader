{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-temp-write",
    "fs:allow-temp-write-recursive",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/arduino-cli",
          "args": true,
          "sidecar": true
        }
      ]
    }
  ]
}
